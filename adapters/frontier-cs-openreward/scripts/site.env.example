# Site env file for serve.sh (FRONTIER_ENV). Copy it outside the checkout and edit the copy: an untracked file
# inside the checkout fails the clean-tree check. serve.sh sources it on every service node, with every
# assignment exported, after `env -i`: use absolute paths, and compute per-node values here.
# It must hold no credentials; serve.sh unsets the usual API keys anyway.

# Required. The address clients reach, normally the node's fabric IP. 0.0.0.0 is refused unless
# ALLOW_ALL_INTERFACES=1, because the port is an unauthenticated shell that runs as you.
OPENREWARD_HOST=$(/usr/sbin/ip -4 -o addr show dev ib0 | awk '{split($4, a, "/"); print a[1]; exit}')
# Required. The server venv's python, installed from adapters/frontier-cs-openreward/server.lock.
FRONTIER_PYTHON=/path/to/venvs/frontier-cs-server/bin/python
# Required. The release's image manifest (version 1, ready), with node-readable image paths.
FRONTIER_IMAGE_MANIFEST=/path/to/frontier-cs-release/image-manifest.json

# Recommended. The commit the checkout must be at; serve.sh refuses any other HEAD.
#FRONTIER_ADAPTER_REVISION=<full commit sha>
# all (188 algorithmic + 12 2.0 tasks; needs 56 CPUs), algorithmic (needs 16) or 2.0.
FRONTIER_SUITE=algorithmic

# Optional, with their defaults.
#FRONTIER_SOURCE_ROOT=<the checkout holding serve.sh>
#FRONTIER_EXCLUDE_TASK_IDS=2.0/vector_db_ann_disk
#FRONTIER_JUDGE_CONCURRENCY=4
#FRONTIER_MIN_FREE_GB=100
#OPENREWARD_FRONTIER_CS_PORT=8085
#SWE_CONTAINER_RUNTIME_BIN=<singularity on PATH>
#OPENREWARD_FRONTIER_SERVER_MAX_RESTARTS=5
